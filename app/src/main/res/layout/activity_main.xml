<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:text="SpeakCharger"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Bunyi otomatis tiap 5% saat charging"
            android:textSize="13sp"
            android:alpha="0.7"
            android:layout_marginBottom="28dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvBattery"
            android:text="Baterai: --"
            android:textSize="18sp"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="28dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnPermissions"
            android:text="Buka Pengaturan Izin"
            android:textSize="14sp"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnToggle"
            android:text="AKTIFKAN"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4CAF50"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnTest"
            android:text="Test Suara TTS"
            android:textSize="14sp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:text="Service tidak aktif"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Cara pakai:&#10;&#10;1. Tekan Buka Pengaturan Izin (kasih semua izin)&#10;2. Tekan AKTIFKAN&#10;3. Colok charger&#10;4. HP bunyi tiap 5%&#10;5. Di 100% bunyi terus sampai cabut"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>
