<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:text="SpeakCharger"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/tvAccessStatus"
        android:text="BELUM AKTIF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#F44336"
        android:layout_marginBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/tvBattery"
        android:text="--"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/tvTimerLabel"
        android:text="Sedang Charging"
        android:textSize="13sp"
        android:textColor="#888888"
        android:layout_marginBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/tvTimer"
        android:text="⏱ --:--:--"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#4CAF50"
        android:layout_marginBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/tvLastSession"
        android:text=""
        android:textSize="12sp"
        android:textColor="#9E9E9E"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btnAccessibility"
        android:text="1. Aktifkan Aksesibilitas"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#E91E63"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnSettings"
        android:text="Suara MP3"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#9C27B0"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnTest"
        android:text="Test"
        android:textSize="14sp"
        android:layout_width="match_parent"
        android:layout_height="48dp"/>

</LinearLayout>
